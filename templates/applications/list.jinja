<div class="page-header d-print-none mb-3">
  <div class="row g-2 align-items-center">
    <div class="col">
      <h2 class="page-title">Applications</h2>
      <div class="text-secondary mt-1">Install popular software on this machine.</div>
    </div>
  </div>
</div>

<div id="application-results" {% if installInProgress %}hx-get="/applications" hx-trigger="every 5s"
  hx-select="#application-results" hx-target="#application-results" hx-swap="outerHTML" {% endif %}>
  <div class="row row-cards">
    {% for application in applications %}
    <div class="col-md-6 col-xl-4">
      <div class="card h-100">
        <div class="card-body">
          <div class="d-flex align-items-start">
            <div class="flex-fill">
              <h3 class="card-title mb-1">{{application.Name}}</h3>
              <div class="mb-2">
                {% if application.Status == STATUS_AVAILABLE %}
                <span class="badge bg-secondary-lt">Not installed</span>
                {% endif %}
                {% if application.Status == STATUS_QUEUED %}
                <span class="badge bg-azure-lt">Install queued</span>
                {% endif %}
                {% if application.Status == STATUS_RUNNING %}
                <span class="badge bg-blue-lt">
                  <span class="spinner-border spinner-border-sm me-1" role="status"></span>Installing
                </span>
                {% endif %}
                {% if application.Status == STATUS_COMPLETE %}
                <span class="badge bg-success-lt">Installed</span>
                {% endif %}
                {% if application.Status == STATUS_FAILED %}
                <span class="badge bg-danger-lt">Install failed</span>
                {% endif %}
              </div>
              <p class="text-secondary mb-0">{{application.Description}}</p>
            </div>
            <i class="ti ti-{{application.Icon}} text-secondary ms-3" style="font-size:2.5rem"></i>
          </div>
        </div>

        {% if application.Status == STATUS_AVAILABLE or application.Status == STATUS_FAILED or application.ID != 0 %}
        <div class="card-footer">
          <div class="btn-list">
            {% if application.Status == STATUS_AVAILABLE or application.Status == STATUS_FAILED %}
            <form method="post" action="/application/install">
              <input type="hidden" name="_csrf_token" value="{{_csrf_token}}" />
              <input type="hidden" name="slug" value="{{application.Slug}}" />
              <button type="submit" class="btn btn-sm btn-primary">
                {% if application.Status == STATUS_FAILED %}
                <i class="ti ti-reload me-1"></i>Retry
                {% else %}
                <i class="ti ti-download me-1"></i>Install
                {% endif %}
              </button>
            </form>
            {% endif %}

            {% if application.ID != 0 %}
            <a href="/logs/application/{{application.ID}}" class="btn btn-sm">
              <i class="ti ti-terminal-2 me-1"></i>Log
            </a>
            {% endif %}
          </div>
        </div>
        {% endif %}
      </div>
    </div>
    {% endfor %}
  </div>
</div>
