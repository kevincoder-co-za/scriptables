<div class="page-header d-print-none mb-3">
  <div class="row g-2 align-items-center">
    <div class="col">
      <div class="page-pretitle">Applications</div>
      <h2 class="page-title">Install {{application.Name}}</h2>
    </div>
  </div>
</div>

<div class="row row-cards">
  <div class="col-lg-7">
    <form class="card" method="post" action="/application/install">
      <input type="hidden" name="_csrf_token" value="{{_csrf_token}}" />
      <input type="hidden" name="slug" value="{{application.Slug}}" />

      <div class="card-header">
        <h3 class="card-title"><i class="ti ti-{{application.Icon}} me-2"></i>{{application.RootPasswordLabel}}</h3>
      </div>

      <div class="card-body">
        <p class="text-secondary">
          {{application.Name}} is installed without a root password by default. Choose one here so the root account
          cannot be used without it. Scriptables keeps <code>sudo mysql</code> working for its own site setup
          and forgets this password once the install finishes, so store it somewhere safe.
        </p>

        <div class="row">
          <div class="col-md-6 mb-3">
            <label class="form-label required">Root password</label>
            <input type="password" class="form-control" name="root_password" autocomplete="new-password" required
              minlength="8" />
            <small class="form-hint">At least 8 characters. Spaces, quotes and backslashes are not allowed.</small>
          </div>

          <div class="col-md-6 mb-3">
            <label class="form-label required">Confirm root password</label>
            <input type="password" class="form-control" name="root_password_confirm" autocomplete="new-password"
              required minlength="8" />
          </div>
        </div>
      </div>

      <div class="card-footer text-end">
        <a href="/applications" class="btn btn-link">Cancel</a>
        <button type="submit" class="btn btn-primary">
          <i class="ti ti-download me-1"></i>Install {{application.Name}}
        </button>
      </div>
    </form>
  </div>
</div>
